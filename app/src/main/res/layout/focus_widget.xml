<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="14dp"
    android:background="#123C31">

    <TextView
        android:id="@+id/widget_status"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="START A FOCUSED STUDY BLOCK"
        android:textColor="#D6AB45"
        android:textSize="10sp"
        android:textStyle="bold"
        android:letterSpacing="0.08" />

    <TextView
        android:id="@+id/widget_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="Your next focus session"
        android:textColor="#FFFAF0"
        android:textSize="13sp"
        android:maxLines="1"
        android:ellipsize="end" />

    <Chronometer
        android:id="@+id/widget_clock"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="3dp"
        android:text="25:00"
        android:textColor="#FFFFFF"
        android:textSize="25sp"
        android:textStyle="bold"
        android:format="%s" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="5dp">

        <Button
            android:id="@+id/widget_open"
            android:layout_width="0dp"
            android:layout_height="38dp"
            android:layout_weight="2"
            android:text="Open Ascent"
            android:textAllCaps="false"
            android:textSize="11sp" />

        <Button
            android:id="@+id/widget_pause"
            android:layout_width="0dp"
            android:layout_height="38dp"
            android:layout_weight="1"
            android:layout_marginStart="5dp"
            android:text="Pause"
            android:textAllCaps="false"
            android:textSize="11sp" />
    </LinearLayout>
</LinearLayout>
