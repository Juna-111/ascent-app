<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/today_widget_row"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:minHeight="42dp"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="4dp"
    android:paddingEnd="4dp"
    android:paddingTop="5dp"
    android:paddingBottom="5dp">

    <TextView
        android:id="@+id/today_widget_row_time"
        android:layout_width="54dp"
        android:layout_height="wrap_content"
        android:text="08:00"
        android:textColor="#D6AB45"
        android:textSize="10sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/today_widget_row_title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:paddingStart="5dp"
        android:paddingEnd="5dp"
        android:text="Study activity"
        android:textColor="#FFFAF0"
        android:textSize="11sp"
        android:maxLines="2"
        android:ellipsize="end" />

    <TextView
        android:id="@+id/today_widget_row_status"
        android:layout_width="24dp"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:text="○"
        android:textColor="#D6AB45"
        android:textSize="17sp"
        android:textStyle="bold" />
</LinearLayout>
